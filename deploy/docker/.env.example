# This file is a sample. Do not commit production credentials.
# Populate in deploy/docker/.env on the VPS with chmod 600.
CB_IMAGE_TAG=sha-REPLACE_WITH_40_CHARACTER_COMMIT_SHA
CB_OIDC_ISSUER=https://auth.ithute.co.ls
CB_OIDC_AUDIENCE=capitalbridge
CB_OIDC_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
CB_DATABASE_URL=postgresql://USERNAME:PASSWORD@DB_HOST:5432/capitalbridge?sslmode=require
CB_PUBLIC_ORIGIN=https://capitalbridge.co.ls
# Never enable public intake until migrations, privacy notice, Redis,
# restricted intake identity and rate-limit tests are confirmed.
CB_PUBLIC_INTAKE_ENABLED=false
CB_PUBLIC_INTAKE_APPROVED=false
